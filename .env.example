# Every adapter defaults to its free local implementation. Copy to .env to switch.

# Travel time and address lookup: "local" (straight-line estimate, saved places) or "relay" (Amazon Location Service routes and Places via the relay)
VITE_TRAVEL=local
# Out-of-app delivery: "browser" (Web Notifications + service worker) or "relay" (SMS via Amazon End User Messaging)
VITE_CHANNEL=browser
# Base URL of the deployed relay (only used when an adapter above is "relay")
VITE_RELAY_URL=
# Token the relay checks (matches RELAY_SHARED_SECRET); single-user deployments only
VITE_RELAY_SECRET=
# Phone number pages go to in relay mode (E.164)
VITE_PAGER_NUMBER=+15555550123

# Relay (AWS Lambda) settings, read by src/relay only
RELAY_REGION=us-east-1
RELAY_ORIGINATION_IDENTITY=
RELAY_SCHEDULER_TARGET_ARN=
RELAY_SCHEDULER_ROLE_ARN=
RELAY_SHARED_SECRET=
