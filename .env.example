# Every adapter defaults to its free local implementation. Copy to .env to switch.

# Travel time and address lookup: "local" (straight-line estimate, saved places) or "relay" (Amazon Location Service routes and Places via the relay)
VITE_TRAVEL=local
# Out-of-app delivery: "browser" (Web Notifications + service worker) or "relay" (SMS via Amazon End User Messaging)
VITE_CHANNEL=browser
# Base URL of the deployed relay (only used when an adapter above is "relay")
VITE_RELAY_URL=
# Token the relay checks (matches RELAY_SHARED_SECRET). It ships in the browser bundle,
# so it only keeps out drive-by traffic; the relay's own limits below do the real work.
VITE_RELAY_SECRET=

# Relay (AWS Lambda) settings, read by src/relay only
RELAY_REGION=us-east-1
RELAY_ORIGINATION_IDENTITY=
RELAY_SCHEDULER_TARGET_ARN=
RELAY_SCHEDULER_ROLE_ARN=
RELAY_SHARED_SECRET=
# The only number the relay ever texts (E.164). Clients cannot pick a destination.
RELAY_PAGER_NUMBER=+15555550123
# The PWA's origin, for example https://pager.example.com. Unset refuses every browser.
RELAY_ALLOWED_ORIGIN=
# Daily caps: distinct pages a day (the beep budget) and texts per page (first beep + repeats)
RELAY_DAILY_PAGE_CAP=6
RELAY_SENDS_PER_PAGE=4
# Zone whose midnight resets the daily cap
RELAY_TIME_ZONE=America/Chicago
