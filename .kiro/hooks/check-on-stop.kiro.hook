{
  "enabled": true,
  "name": "Typecheck and unit tests on stop",
  "description": "When the agent finishes a turn, run the typecheck and the unit suite so every turn ends green.",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "npm run check"
  }
}
