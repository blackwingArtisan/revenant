{
  "enabled": true,
  "name": "Page budget guard",
  "description": "When the planner, escalation, runtime or pager codes change, restate Revenant's paging rules and ask for a unit test before continuing.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/engine/plan.ts", "src/engine/alerts.ts", "src/engine/runtime.ts", "src/engine/codes.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "You just edited the paging engine. Before continuing, confirm: (1) no page fires at an event's start unless the action is to start (focus block or video call); (2) the beeping pages per local day never exceed settings.dailyBudget, and anything cut lands in that day's digest; (3) the engine stays pure, with no Date.now(), randomness or I/O; (4) ACK still cancels every later repeat of that page. Add or update a unit test under tests/unit for any rule you changed, then run `npm test`."
  }
}
