{
  "enabled": true,
  "name": "Run unit tests on source save",
  "description": "Runs the Vitest unit suite whenever a TypeScript file under src/ or tests/unit/ is saved, so a broken lead-time, budget or calendar rule is caught at once.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/**/*.ts", "src/**/*.tsx", "tests/unit/**/*.ts"]
  },
  "then": {
    "type": "runCommand",
    "command": "npm test"
  }
}
