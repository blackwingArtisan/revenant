{
  "enabled": true,
  "name": "Keep the wallet code card in sync",
  "description": "When pager codes change, make sure every code has a row on the wallet code card and in the README.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/engine/codes.ts"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "src/engine/codes.ts changed. Check that every code in CODE_FOR, plus the boot and missed codes, has an entry in CODE_CARD with a plain-language meaning, that src/app/components/CodeCard.tsx still renders them all, and that the code table in README.md matches. Fix any mismatch and run `npm test`."
  }
}
